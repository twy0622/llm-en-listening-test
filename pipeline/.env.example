# Copy to pipeline/.env (gitignored).

# --- LLM (choose at least one) -----------------------------------------------
# Workers AI: create an API token with "Workers AI: Read" and copy the account ID
# from the Cloudflare dashboard. This is the cheapest option for the offline
# factory and uses the same free daily allocation as the deployed Worker.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# Gemini API (Google AI Studio) is the easiest key to obtain if you do not want
# to create a Cloudflare token. Set only one of these two provider groups.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash

# OpenCode's free tier is app-only and returns 403 to external clients. A paid
# Zen key can be used as a last resort; leave this blank for the normal setup.
# OPENCODE_BASE_URL=https://opencode.ai
# OPENCODE_MODEL=deepseek-v4.1-flash-free
# OPENCODE_API_KEY=

# --- Publishing --------------------------------------------------------------
ADMIN_API_URL=http://localhost:8787
ADMIN_TOKEN=dev-admin-token

# --- Output ------------------------------------------------------------------
OUT_DIR=out
