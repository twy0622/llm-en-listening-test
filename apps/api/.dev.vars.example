# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` (gitignored). Production values go in `wrangler secret put`.

# Signs device + attempt tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATTEMPT_SECRET=dev-only-replace-me-with-32-plus-random-bytes

# Required by /api/admin/* and the content factory's `publish` command.
ADMIN_TOKEN=dev-admin-token

# Optional: an OpenCode/Zen key. Free OpenCode models are app-only and reject
# external Workers with 403, so leave this blank unless you have a usable key.
# OPENCODE_API_KEY=

# Comma-separated extra origins allowed to call the API in development.
APP_ORIGIN=http://localhost:5173
